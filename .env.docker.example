# Use a real domain so Caddy can provision HTTPS automatically, e.g. translate.example.com.
# For local HTTP testing, keep :80. Microphone access on client devices requires HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# First GPU on the server. You can use a UUID returned by nvidia-smi -L instead.
GPU_DEVICE_ID=0

# Production prioritizes accuracy. Set to small to prioritize the lowest latency.
ASR_DEFAULT_MODEL=turbo
PREPARE_TURBO_CACHE=true

# Adjust for the server's CPU count. Do not increase ASR_NUM_WORKERS; it uses more VRAM.
ASR_CPU_THREADS=4
TRANSLATION_INTRA_THREADS=4

# Only needed when accessing the backend directly from another origin. Leave blank for same-origin access.
ALLOWED_ORIGINS=
