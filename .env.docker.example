# Dùng domain thật để Caddy tự cấp HTTPS, ví dụ: translate.example.com
# Nếu chỉ test HTTP local, giữ :80. Microphone trên máy client cần HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# GPU đầu tiên trên server. Có thể thay bằng UUID trả về từ nvidia-smi -L.
GPU_DEVICE_ID=0

# Production ưu tiên độ chính xác. Đổi thành small nếu ưu tiên độ trễ thấp nhất.
ASR_DEFAULT_MODEL=turbo
PREPARE_TURBO_CACHE=true

# Điều chỉnh theo số CPU server, không tăng ASR_NUM_WORKERS vì sẽ tốn thêm VRAM.
ASR_CPU_THREADS=4
TRANSLATION_INTRA_THREADS=4

# Chỉ cần khi truy cập backend trực tiếp từ origin khác. Cùng origin để trống.
ALLOWED_ORIGINS=
