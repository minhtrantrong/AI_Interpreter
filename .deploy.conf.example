# Copy this file to .deploy.conf and enter the server's SSH details.
SERVER_HOST=192.168.1.100
SERVER_USER=deploy
SSH_PORT=22

# Use a directory that SERVER_USER can write to without sudo.
SERVER_PATH=/home/deploy/apps/translate-realtime

# Leave blank if the SSH key is already loaded in ssh-agent.
SSH_KEY=/home/your-local-user/.ssh/id_ed25519

# Local production configuration file, uploaded separately with permissions set to 600.
DEPLOY_ENV_FILE=.env.docker

# Downloading and converting the models may take several minutes the first time.
DEPLOY_HEALTH_TIMEOUT=1800
